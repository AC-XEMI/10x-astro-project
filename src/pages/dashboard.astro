---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import DashboardView from "@/components/dashboard/DashboardView.astro";
import { createClient } from "@/lib/supabase";
import {
  PERIODS,
  TREND_MONTHS,
  computeDashboardStats,
  monthLowerBound,
  toMonthIndex,
  type DashboardStats,
  type DashboardVisit,
  type PeriodKey,
  type RecentReport,
} from "@/lib/services/dashboard-stats";

const PAGE_SIZE = 1000; // PostgREST default max rows per request

const periodParam = Astro.url.searchParams.get("okres");
const period: PeriodKey = periodParam && periodParam in PERIODS ? (periodParam as PeriodKey) : "1m";
const periodMonths = PERIODS[period];

const supabase = createClient(Astro.request.headers, Astro.cookies);

let stats: DashboardStats | null = null;
let recent: RecentReport[] = [];
let loadError = false;

if (supabase) {
  const [latestResult, recentResult] = await Promise.all([
    supabase.from("visits").select("visit_date").order("visit_date", { ascending: false }).limit(1).maybeSingle(),
    supabase.from("reports").select("*").order("uploaded_at", { ascending: false }).limit(3),
  ]);

  if (latestResult.error || recentResult.error) {
    console.error("Failed to load dashboard:", latestResult.error ?? recentResult.error);
    loadError = true;
  } else {
    if (latestResult.data) {
      const refMonth = toMonthIndex(latestResult.data.visit_date);
      // Enough history for both the previous comparison window and the trend chart.
      const firstMonth = refMonth - Math.max(2 * periodMonths, TREND_MONTHS) + 1;
      const visits: DashboardVisit[] = [];
      for (let from = 0; ; from += PAGE_SIZE) {
        const { data, error } = await supabase
          .from("visits")
          .select("report_id, representative_name, visit_date, deviations(rule, status)")
          .gte("visit_date", monthLowerBound(firstMonth))
          .order("id")
          .range(from, from + PAGE_SIZE - 1);
        if (error) {
          console.error("Failed to load dashboard visits:", error);
          loadError = true;
          break;
        }
        visits.push(...data);
        if (data.length < PAGE_SIZE) break;
      }
      if (!loadError) stats = computeDashboardStats(visits, refMonth, periodMonths);
    }

    // "Ostatnie raporty" renders only alongside the stats, so skip the per-report counts otherwise.
    recent = await Promise.all(
      (stats ? recentResult.data : []).map(async (report) => {
        const { count, error } = await supabase
          .from("deviations")
          .select("id, visits!inner(report_id)", { count: "exact", head: true })
          .eq("status", "unreviewed")
          .eq("visits.report_id", report.id);
        if (error) console.error("Failed to count unreviewed deviations:", error);
        return { ...report, unreviewed: error ? null : count };
      }),
    );
  }
}
---

<Layout title="Pulpit">
  <Topbar />
  <main class="mx-auto max-w-[1100px] space-y-6 p-6">
    <DashboardView stats={stats} recent={recent} period={period} loadError={loadError} />
  </main>
</Layout>
