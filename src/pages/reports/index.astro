---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import ReportsList from "@/components/reports/ReportsList";
import ReportUpload from "@/components/reports/ReportUpload";
import { createClient } from "@/lib/supabase";
import { reportErrorMessage } from "@/lib/report-errors";
import type { Tables } from "@/types";

const PAGE_SIZE = 20;

const error = Astro.url.searchParams.get("error");
const deleted = Astro.url.searchParams.get("deleted");
const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);

const supabase = createClient(Astro.request.headers, Astro.cookies);

let reports: Tables<"reports">[] = [];
let count: number | null = null;

if (supabase) {
  const {
    data,
    error: fetchError,
    count: fetchCount,
  } = await supabase
    .from("reports")
    .select("*", { count: "exact" })
    .order("uploaded_at", { ascending: false })
    .range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
  if (fetchError) {
    console.error("Failed to fetch reports list:", fetchError);
  } else {
    reports = data;
    count = fetchCount;
  }
}
---

<Layout title="Raporty">
  <Topbar />
  <main class="mx-auto max-w-[1100px] space-y-6 p-6">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Raporty</h1>
      <p class="text-sm text-muted-foreground">
        Wgraj trasówki przedstawicieli, aby sprawdzić odstępstwa: brak GPS, telefon zamiast wizyty, odchylenie od trasy.
      </p>
    </div>

    {deleted && <Banner variant="success">Raport został usunięty.</Banner>}
    {error && <Banner variant="error">{reportErrorMessage(error)}</Banner>}

    <div>
      <ReportUpload client:load />
    </div>

    <div class="rounded-lg border border-border bg-card p-4">
      <ReportsList reports={reports} page={page} client:load />
      {count !== null && (page > 1 || page * PAGE_SIZE < count) && (
        <div class="mt-4 flex justify-between text-sm">
          {page > 1 ? (
            <a href={`/reports?page=${page - 1}`} class="text-primary hover:underline">
              Poprzednia
            </a>
          ) : (
            <span />
          )}
          {page * PAGE_SIZE < count ? (
            <a href={`/reports?page=${page + 1}`} class="text-primary hover:underline">
              Następna
            </a>
          ) : (
            <span />
          )}
        </div>
      )}
    </div>
  </main>
</Layout>
