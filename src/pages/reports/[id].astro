---
import { FileText, Undo2 } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import DeviationsList from "@/components/reports/DeviationsList";
import type { VisitWithDeviations } from "@/components/reports/DeviationsList";
import { createClient } from "@/lib/supabase";
import { formatDateTime } from "@/lib/format-date";
import type { Tables } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let report: Tables<"reports"> | null = null;
let visits: VisitWithDeviations[] = [];

if (supabase) {
  const [reportResult, visitsResult] = await Promise.all([
    supabase
      .from("reports")
      .select("*")
      .eq("id", id ?? "")
      .maybeSingle(),
    supabase
      .from("visits")
      .select("*, deviations(*)")
      .eq("report_id", id ?? ""),
  ]);
  if (!reportResult.error && reportResult.data && !visitsResult.error) {
    report = reportResult.data;
    visits = visitsResult.data;
  }
}
---

<Layout title={report ? report.original_filename : "Wynik raportu"}>
  <Topbar />
  <main class="mx-auto max-w-[1100px] space-y-6 p-6">
    <div class="space-y-3">
      {/* Plain <a> with button classes: a React <Button asChild> gets its Astro children wrapped
          in <astro-slot>, so Radix Slot never merges the button styles onto the link. */}
      <a href="/reports" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
        <Undo2 />
        Wróć do raportów
      </a>
      {report ? (
        <>
          <div class="flex min-w-0 items-center gap-3">
            <FileText className="size-5 shrink-0 text-muted-foreground" />
            <h1 class="truncate text-2xl font-semibold tracking-tight">{report.original_filename}</h1>
          </div>
          <p class="text-sm text-muted-foreground">
            wgrano {formatDateTime(report.uploaded_at)} · {report.row_count ?? visits.length} wierszy
          </p>
        </>
      ) : (
        <h1 class="text-2xl font-semibold tracking-tight">Wynik raportu</h1>
      )}
    </div>

    {report ? (
      <DeviationsList visits={visits} reportId={report.id} client:load />
    ) : (
      <Banner variant="error">Nie znaleziono raportu.</Banner>
    )}
  </main>
</Layout>
