---
import { FileText, Undo2 } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import DeviationsList from "@/components/reports/DeviationsList";
import type { VisitWithDeviations } from "@/components/reports/DeviationsList";
import ReportLoadError from "@/components/reports/ReportLoadError.astro";
import { createClient } from "@/lib/supabase";
import { REPORT_LOAD_ERROR_STATUS, type ReportLoadErrorKind } from "@/lib/report-load-errors";
import { formatDateTime } from "@/lib/format-date";
import type { Tables } from "@/types";

const { id } = Astro.params;

// A malformed id can never match a report, and querying with it would only make Postgres reject
// the uuid cast — a "not found", not a database failure — so it is decided without a query.
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let report: Tables<"reports"> | null = null;
let visits: VisitWithDeviations[] = [];
let loadError: ReportLoadErrorKind | null = null;

if (!supabase) {
  loadError = "not_configured";
} else if (!id || !UUID_RE.test(id)) {
  loadError = "not_found";
} else {
  const [reportResult, visitsResult] = await Promise.all([
    supabase.from("reports").select("*").eq("id", id).maybeSingle(),
    supabase.from("visits").select("*, deviations(*)").eq("report_id", id),
  ]);
  if (reportResult.error || visitsResult.error) {
    // Raw Supabase messages go to the server log only, never to the page.
    if (reportResult.error) console.error("Report details: loading the report failed:", reportResult.error.message);
    if (visitsResult.error) console.error("Report details: loading visits failed:", visitsResult.error.message);
    loadError = "load_failed";
  } else if (!reportResult.data) {
    loadError = "not_found";
  } else {
    report = reportResult.data;
    visits = visitsResult.data;
  }
}

// Must be set here, before any output is streamed.
if (loadError) {
  Astro.response.status = REPORT_LOAD_ERROR_STATUS[loadError];
}
---

<Layout title={report ? report.original_filename : "Wynik raportu"}>
  <Topbar />
  <main class="mx-auto max-w-[1100px] space-y-6 p-6">
    <div class="space-y-3">
      {/* Plain <a> with button classes: a React <Button asChild> gets its Astro children wrapped
          in <astro-slot>, so Radix Slot never merges the button styles onto the link. */}
      <a href="/reports" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
        <Undo2 />
        Wróć do raportów
      </a>
      {report ? (
        <>
          <div class="flex min-w-0 items-center gap-3">
            <FileText className="size-5 shrink-0 text-muted-foreground" />
            <h1 class="truncate text-2xl font-semibold tracking-tight">{report.original_filename}</h1>
          </div>
          <p class="text-sm text-muted-foreground">
            wgrano {formatDateTime(report.uploaded_at)} · {report.row_count ?? visits.length} wierszy
          </p>
        </>
      ) : (
        <h1 class="text-2xl font-semibold tracking-tight">Wynik raportu</h1>
      )}
    </div>

    {report ? (
      <DeviationsList visits={visits} reportId={report.id} client:load />
    ) : (
      <ReportLoadError kind={loadError ?? "not_found"} />
    )}
  </main>
</Layout>
