---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import DeviationsList from "@/components/reports/DeviationsList";
import type { VisitWithDeviations } from "@/components/reports/DeviationsList";
import { createClient } from "@/lib/supabase";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let visits: VisitWithDeviations[] = [];
let notFound = true;

if (supabase) {
  const { data, error } = await supabase
    .from("visits")
    .select("*, deviations(*)")
    .eq("report_id", id ?? "");
  if (!error && data.length > 0) {
    visits = data;
    notFound = false;
  }
}
---

<Layout title="Wynik raportu">
  <Topbar />
  <div class="min-h-screen bg-slate-50 p-4">
    <div class="mx-auto max-w-3xl py-8">
      <h1 class="mb-6 text-2xl font-bold text-slate-900">Wynik raportu</h1>
      {notFound ? (
        <Banner variant="error">Nie znaleziono raportu.</Banner>
      ) : (
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <DeviationsList visits={visits} reportId={id ?? ""} client:load />
        </div>
      )}
    </div>
  </div>
</Layout>
