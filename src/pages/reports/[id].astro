---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import DeviationsList from "@/components/reports/DeviationsList";
import type { VisitWithDeviations } from "@/components/reports/DeviationsList";
import { createClient } from "@/lib/supabase";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let visits: VisitWithDeviations[] = [];
let notFound = true;

if (supabase) {
  const { data, error } = await supabase
    .from("visits")
    .select("*, deviations(*)")
    .eq("report_id", id ?? "");
  if (!error && data.length > 0) {
    visits = data;
    notFound = false;
  }
}
---

<Layout title="Wynik raportu">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-3xl">
      <a href="/reports" class="mb-4 inline-block text-sm text-blue-100/80 hover:text-white">
        ← Powrót do listy raportów
      </a>
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Wynik raportu
      </h1>
      {notFound ? (
        <Banner variant="error">Nie znaleziono raportu.</Banner>
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
          <DeviationsList visits={visits} reportId={id ?? ""} client:load />
        </div>
      )}
    </div>
  </div>
</Layout>
