---
import type { SupabaseClient } from "@supabase/supabase-js";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import DeviationsList from "@/components/reports/DeviationsList";
import type { VisitWithDeviations } from "@/components/reports/DeviationsList";
import { createClient } from "@/lib/supabase";
import type { Database } from "@/types";

const { id } = Astro.params;

// createClient() is not parameterized with Database in src/lib/supabase.ts (out of this phase's
// file scope), so .from() would otherwise resolve to `any`; cast locally to get typed queries.
const supabase = createClient(Astro.request.headers, Astro.cookies) as SupabaseClient<Database> | null;

let visits: VisitWithDeviations[] = [];
let notFound = true;

if (supabase) {
  const { data, error } = await supabase
    .from("visits")
    .select("*, deviations(*)")
    .eq("report_id", id ?? "");
  if (!error && data.length > 0) {
    visits = data;
    notFound = false;
  }
}
---

<Layout title="Wynik raportu">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Wynik raportu
      </h1>
      {notFound ? (
        <Banner variant="error">Nie znaleziono raportu.</Banner>
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
          <DeviationsList visits={visits} client:load />
        </div>
      )}
    </div>
  </div>
</Layout>
