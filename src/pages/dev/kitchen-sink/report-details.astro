---
// Dev-only kitchen sink: every state of the report details page (Szczegóły raportu), light and dark,
// from fixtures. Not linked from product nav, not in PROTECTED_ROUTES (src/middleware.ts) — no auth needed.
// Renders the same components the real page uses (src/pages/reports/[id].astro): DeviationsList and
// ReportLoadError. Expanded groups, the open visit, filters, pending ids and action errors come from
// DeviationsList's dev-only initial* props. Every instance gets its own id prefix, so the details row
// ids (visit-details-<visit id>) stay unique on the page.
import { FileText, Undo2 } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import DeviationsList, { type VisitWithDeviations } from "@/components/reports/DeviationsList";
import ReportLoadError from "@/components/reports/ReportLoadError.astro";
import { buttonVariants } from "@/components/ui/button";
import { formatDateTime } from "@/lib/format-date";
import type { ReportLoadErrorKind } from "@/lib/report-load-errors";
import { cn } from "@/lib/utils";

const REPORT_ID = "11111111-1111-1111-1111-111111111111";
const FILE_NAME = "trasowki-wrzesien-2026.xlsx";
const UPLOADED_AT = "2026-10-06T07:14:00Z";
const ANNA = "Anna Kowalska";
const PIOTR = "Piotr Nowak";

type Visit = VisitWithDeviations;
type Deviation = Visit["deviations"][number];

function visit(prefix: string, id: string, fields: Partial<Visit>): Visit {
  return {
    id: `${prefix}${id}`,
    report_id: REPORT_ID,
    created_at: UPLOADED_AT,
    representative_name: ANNA,
    visit_date: "2026-09-01T00:00:00+00:00",
    visited_client: null,
    activity_type: "wizyta",
    gps_enabled: true,
    distance_km: null,
    time_on_site_minutes: null,
    visited_latitude: null,
    visited_longitude: null,
    planned_route_raw: null,
    raw_data: null,
    deviations: [],
    ...fields,
  };
}

function deviation(visitId: string, id: string, fields: Partial<Deviation>): Deviation {
  return {
    id: `${visitId}-${id}`,
    visit_id: visitId,
    created_at: UPLOADED_AT,
    rule: "missing_gps",
    status: "unreviewed",
    detail: null,
    reviewed_at: null,
    ...fields,
  };
}

// Two representatives; per frame prefix so every island has its own ids.
// - a1: multi-rule, no-GPS visit (one deviation unreviewed, one reviewed with reviewed_at) — the open visit
// - a2: fully reviewed route deviation; a3: visit without deviations (counts only in "Wizyty")
// - p1: no-GPS visit with no stored detail (UI fallback text); p2: phone contact, unreviewed
function makeVisits(prefix: string): Visit[] {
  const a1 = `${prefix}a1`;
  const a2 = `${prefix}a2`;
  const p1 = `${prefix}p1`;
  const p2 = `${prefix}p2`;
  return [
    visit(prefix, "a1", {
      visit_date: "2026-09-04T00:00:00+00:00",
      visited_client: "Hurtownia Biedronka Sp. z o.o.",
      activity_type: null,
      gps_enabled: false,
      time_on_site_minutes: 0,
      planned_route_raw: ["Kraków", "Wieliczka", "Bochnia"],
      deviations: [
        deviation(a1, "gps", { rule: "missing_gps" }),
        deviation(a1, "phone", {
          rule: "phone_instead_of_visit",
          detail: "brak GPS i czas na miejscu 0 min (typ aktywności: brak danych lub nierozpoznany)",
          status: "reviewed",
          reviewed_at: "2026-10-06T09:41:00Z",
        }),
      ],
    }),
    visit(prefix, "a2", {
      visit_date: "2026-09-02T00:00:00+00:00",
      visited_client: "Sklep Społem nr 12",
      distance_km: 48.2,
      time_on_site_minutes: 25,
      visited_latitude: 50.0647,
      visited_longitude: 19.945,
      planned_route_raw: ["Kraków", "Skawina"],
      deviations: [
        deviation(a2, "route", {
          rule: "route_deviation",
          detail: "poza zaplanowaną trasą; nadmiarowy dystans: zgłoszono 48.2 km, linia prosta 14.6 km",
          status: "reviewed",
          reviewed_at: "2026-10-06T09:38:00Z",
        }),
      ],
    }),
    visit(prefix, "a3", { visit_date: "2026-09-01T00:00:00+00:00", visited_client: "Delikatesy Centrum" }),
    visit(prefix, "p1", {
      representative_name: PIOTR,
      visit_date: "2026-09-03T00:00:00+00:00",
      visited_client: "Apteka Pod Lwem",
      gps_enabled: false,
      time_on_site_minutes: 15,
      deviations: [deviation(p1, "gps", { rule: "missing_gps" })],
    }),
    visit(prefix, "p2", {
      representative_name: PIOTR,
      visit_date: "2026-09-01T00:00:00+00:00",
      visited_client: "Kiosk Ruch 7",
      activity_type: "telefon",
      deviations: [deviation(p2, "phone", { rule: "phone_instead_of_visit", detail: "typ aktywności: telefon" })],
    }),
  ];
}

const noDeviationVisits = (prefix: string) =>
  makeVisits(prefix).map((item) => ({ ...item, deviations: [] as Deviation[] }));

const LOAD_ERRORS: { label: string; kind: ReportLoadErrorKind }[] = [
  { label: "Nie znaleziono (not_found, HTTP 404)", kind: "not_found" },
  { label: "Brak konfiguracji (not_configured, HTTP 503)", kind: "not_configured" },
  { label: "Nieudane wczytanie (load_failed, HTTP 500)", kind: "load_failed" },
];

const THEMES = [
  { label: "Jasny", className: "", key: "l" },
  { label: "Ciemny", className: "dark", key: "d" },
];

// Below sm the frames drop the outer chrome so a frame is exactly as wide as the real page body
// (<main class="p-6"> in src/pages/reports/[id].astro) - a 390px screenshot then shows the real layout.
const section = "space-y-4 py-6 sm:rounded-2xl sm:border sm:border-border sm:bg-card sm:p-6 sm:shadow-sm";
const sectionText = "px-6 sm:px-0";
const frame = "space-y-6 bg-background p-6 text-foreground sm:rounded-xl sm:border sm:border-border";
const caption = "text-xs font-medium text-muted-foreground";
// Same classes as the real controls in DeviationsList.tsx; the forced classes below are static
// stand-ins for :hover / :focus-visible (a screenshot cannot hold either state).
const backLink = buttonVariants({ variant: "outline", size: "sm" });
const groupHeader = "flex w-full flex-wrap items-center gap-4 rounded-lg px-4 py-3 text-left outline-none";
const dateButton = "rounded-sm text-sm font-medium tabular-nums outline-none";
const selectClass = "border-input bg-card h-9 rounded-md border px-3 text-sm shadow-xs outline-none";
const outlineSm = buttonVariants({ variant: "outline", size: "sm" });
const forcedRow = "rounded-md px-2 py-2 text-sm";
const forcedRing = "border-ring ring-[3px] ring-ring/50";
---

<Layout title="Kitchen sink – Szczegóły raportu">
  <div class="mx-auto max-w-[1100px] space-y-8 py-6 sm:p-6">
    <div class:list={["space-y-1", sectionText]}>
      <h1 class="text-2xl font-semibold tracking-tight">Kitchen sink: Szczegóły raportu</h1>
      <p class="text-sm text-muted-foreground">
        Strona deweloperska — wszystkie 7 stanów szczegółów raportu w jasnym i ciemnym motywie, z danych testowych (bez
        Supabase). Treść renderują te same komponenty co <code>/reports/[id]</code>:
      </p>
      <p class="text-sm text-muted-foreground">
        <code>DeviationsList</code> (propsy tylko do kitchen sinka: <code>initialExpandedReps</code>,{" "}
        <code>initialOpenVisitIds</code>, <code>initialFilters</code>, <code>initialPendingIds</code>,{" "}
        <code>initialActionError</code>) i <code>ReportLoadError</code>.
      </p>
    </div>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>1. Domyślny (default)</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Nagłówek strony (te same klasy co w <code>[id].astro</code>) i lista: dwóch przedstawicieli, grupa „{ANNA}”
        rozwinięta, otwarta wizyta z dwiema regułami bez GPS (jedna sprawdzona, z datą sprawdzenia), obok wizyta w pełni
        sprawdzona. Grupa „{PIOTR}” zwinięta, jak każda grupa po wczytaniu strony.
      </p>
      {THEMES.map((theme) => (
        <div class:list={theme.className}>
          <div class:list={frame}>
            <p class:list={caption}>{theme.label}</p>
            <div class="space-y-3">
              <a href="/reports" class:list={backLink}>
                <Undo2 />
                Wróć do raportów
              </a>
              <div class="flex min-w-0 items-center gap-3">
                <FileText className="size-5 shrink-0 text-muted-foreground" />
                <h3 class="truncate text-2xl font-semibold tracking-tight">{FILE_NAME}</h3>
              </div>
              <p class="text-sm text-muted-foreground">wgrano {formatDateTime(UPLOADED_AT)} · 5 wierszy</p>
            </div>
            <div>
              <DeviationsList
                visits={makeVisits(`${theme.key}-default-`)}
                reportId={REPORT_ID}
                initialExpandedReps={[ANNA]}
                initialOpenVisitIds={[`${theme.key}-default-a1`]}
                client:load
              />
            </div>
          </div>
        </div>
      ))}
    </section>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>2. Najechanie (hover)</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Statyczny zrzut nie utrwali <code>:hover</code>. Nagłówek grupy przedstawiciela i wiersz wizyty przechodzą w{" "}
        <code>hover:bg-muted/50</code>, przyciski „outline” w <code>hover:bg-accent</code>. Poniżej te same klasy z
        wymuszonym tłem najechania (próbki).
      </p>
      <div class="grid gap-4 md:grid-cols-2">
        {THEMES.map((theme) => (
          <div class:list={theme.className}>
            <div class:list={frame}>
              <p class:list={caption}>{theme.label}</p>
              <div class:list={[groupHeader, "border bg-muted/50"]}>
                <span class="font-semibold">{PIOTR}</span>
                <span class="text-xs text-muted-foreground">nagłówek grupy pod kursorem</span>
              </div>
              <div class:list={[forcedRow, "bg-muted/50"]}>03.09.2026 — wiersz wizyty pod kursorem</div>
              <span class:list={cn(outlineSm, "bg-accent text-accent-foreground dark:bg-input/50")}>
                Oznacz jako sprawdzone
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>3. Widoczny fokus (focus-visible)</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Data wizyty, listy wyboru, nagłówek grupy i przyciski mają pierścień{" "}
        <code>focus-visible:ring-[3px] focus-visible:ring-ring/50</code> (token <code>--ring</code>). Poniżej pierścień
        wymuszony statycznie na tych samych klasach (próbki); na żywej stronie sprawdź klawiszem Tab.
      </p>
      <div class="grid gap-4 md:grid-cols-2">
        {THEMES.map((theme) => (
          <div class:list={theme.className}>
            <div class:list={frame}>
              <p class:list={caption}>{theme.label}</p>
              <div class="flex flex-wrap items-center gap-4">
                <span class:list={[dateButton, forcedRing]}>04.09.2026</span>
                <span class:list={[selectClass, "inline-flex items-center", forcedRing]}>Wszyscy przedstawiciele</span>
                <span class:list={cn(outlineSm, forcedRing)}>Oznacz jako sprawdzone</span>
              </div>
              <div class:list={[groupHeader, "border", forcedRing]}>
                <span class="font-semibold">{ANNA}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>4. Wyłączony (disabled)</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Zmiana statusu w toku (<code>initialPendingIds</code>): przyciski otwartej wizyty są nieaktywne do odpowiedzi
        serwera. Pod spodem filtry bez dopasowań — eksport CSV/XLSX nieaktywny.
      </p>
      {THEMES.map((theme) => {
        const prefix = `${theme.key}-pending-`;
        const pendingVisits = makeVisits(prefix);
        return (
          <div class:list={theme.className}>
            <div class:list={frame}>
              <p class:list={caption}>{theme.label} — zapis w toku</p>
              <div>
                <DeviationsList
                  visits={pendingVisits}
                  reportId={REPORT_ID}
                  initialExpandedReps={[ANNA]}
                  initialOpenVisitIds={[`${prefix}a1`]}
                  initialPendingIds={pendingVisits[0].deviations.map((item) => item.id)}
                  client:load
                />
              </div>
              <p class:list={caption}>{theme.label} — filtry bez dopasowań (eksport nieaktywny)</p>
              <div>
                <DeviationsList
                  visits={makeVisits(`${theme.key}-nomatch-`)}
                  reportId={REPORT_ID}
                  initialFilters={{ representative: PIOTR, rule: "route_deviation" }}
                  client:load
                />
              </div>
            </div>
          </div>
        );
      })}
    </section>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>5. Błąd (error)</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Błędy akcji w liście (<code>initialActionError</code>): nieudana zmiana statusu i nieudany eksport. Pod nimi
        błędy strony z <code>ReportLoadError</code> pod nagłówkiem „Wynik raportu” (raport niewczytany).
      </p>
      {THEMES.map((theme) => (
        <div class:list={theme.className}>
          <div class:list={frame}>
            <p class:list={caption}>{theme.label} — nieudana zmiana statusu (review)</p>
            <div>
              <DeviationsList
                visits={makeVisits(`${theme.key}-err-review-`)}
                reportId={REPORT_ID}
                initialActionError="review"
                client:load
              />
            </div>
            <p class:list={caption}>{theme.label} — nieudany eksport (export)</p>
            <div>
              <DeviationsList
                visits={makeVisits(`${theme.key}-err-export-`)}
                reportId={REPORT_ID}
                initialActionError="export"
                client:load
              />
            </div>
            <div class="space-y-3">
              <a href="/reports" class:list={backLink}>
                <Undo2 />
                Wróć do raportów
              </a>
              <h3 class="text-2xl font-semibold tracking-tight">Wynik raportu</h3>
            </div>
            {LOAD_ERRORS.map((item) => (
              <div class="space-y-2">
                <p class:list={caption}>{item.label}</p>
                <ReportLoadError kind={item.kind} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>6. Pusty (empty)</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Raport bez wizyt, raport z wizytami bez odstępstw i filtry bez dopasowań (z przyciskiem „Wyczyść filtry”).
      </p>
      {THEMES.map((theme) => (
        <div class:list={theme.className}>
          <div class:list={frame}>
            <p class:list={caption}>{theme.label} — brak wizyt</p>
            <div>
              <DeviationsList visits={[]} reportId={REPORT_ID} client:load />
            </div>
            <p class:list={caption}>{theme.label} — brak odstępstw</p>
            <div>
              <DeviationsList visits={noDeviationVisits(`${theme.key}-clean-`)} reportId={REPORT_ID} client:load />
            </div>
            <p class:list={caption}>{theme.label} — brak dopasowań do filtrów</p>
            <div>
              <DeviationsList
                visits={makeVisits(`${theme.key}-empty-filter-`)}
                reportId={REPORT_ID}
                initialFilters={{ status: "done", rule: "missing_gps" }}
                client:load
              />
            </div>
          </div>
        </div>
      ))}
    </section>

    <section class:list={section}>
      <h2 class:list={["text-xl font-semibold", sectionText]}>7. Ładowanie (loading) — N/A</h2>
      <p class:list={["text-sm text-muted-foreground", sectionText]}>
        Raport i wizyty są wczytywane na serwerze, zanim HTML trafi do przeglądarki; filtrowanie, sortowanie i eksport
        działają w przeglądarce na już pobranych wierszach. Jedyne oczekiwanie — zapis zmiany statusu — jest pokazane w
        stanie 4 jako nieaktywne przyciski.
      </p>
    </section>
  </div>
</Layout>
