---
// Dev-only kitchen sink for the dashboard (Pulpit). Not linked from product nav, not in
// PROTECTED_ROUTES (src/middleware.ts) — no auth needed.
// Phase 1 stub (context/changes/dashboard-ui-tokens/plan.md): proves the React Card renders
// correctly from Astro (children arrive wrapped in a display:contents astro-static-slot).
// Phase 4 replaces this with every dashboard state, light and dark.
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
---

<Layout title="Kitchen sink – Pulpit">
  <div class="mx-auto max-w-3xl space-y-6 p-6">
    <h1 class="text-2xl font-semibold tracking-tight">Kitchen sink: Pulpit</h1>
    <div class="grid gap-4 sm:grid-cols-2">
      <Card>
        <CardHeader>
          <CardTitle>Ranking przedstawicieli</CardTitle>
          <CardDescription>wrzesień 2026 · sortowane wg liczby odstępstw</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">Treść karty renderowana z pliku Astro.</p>
        </CardContent>
      </Card>
      <div class="dark">
        <Card>
          <CardHeader>
            <CardTitle>Ta sama karta w ciemnym motywie</CardTitle>
            <CardDescription>tokeny z .dark w poddrzewie</CardDescription>
          </CardHeader>
          <CardContent>
            <p class="text-sm text-muted-foreground">Treść karty renderowana z pliku Astro.</p>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</Layout>
