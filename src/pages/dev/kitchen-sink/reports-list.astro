---
// Dev-only kitchen sink: every state of the upload card + reports table, side by side.
// Not linked from product nav, not in PROTECTED_ROUTES (src/middleware.ts) — no auth needed.
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import ReportsList from "@/components/reports/ReportsList";
import ReportUpload from "@/components/reports/ReportUpload";
import { Button } from "@/components/ui/button";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from "@/components/ui/table";
import { Search, Trash2 } from "lucide-react";
import { checkRequiredColumns } from "@/lib/services/report-columns";
import type { Tables } from "@/types";

const sampleReports: Tables<"reports">[] = [
  {
    id: "11111111-1111-1111-1111-111111111111",
    created_at: "2026-10-01T10:00:00Z",
    deviation_count: 37,
    original_filename: "raport_wrzesien.csv",
    row_count: 128,
    uploaded_at: "2026-10-01T10:00:00Z",
    user_id: "00000000-0000-0000-0000-000000000001",
  },
  {
    id: "22222222-2222-2222-2222-222222222222",
    created_at: "2026-09-28T09:15:00Z",
    deviation_count: 0,
    original_filename: "raport_sierpien.xlsx",
    row_count: 342,
    uploaded_at: "2026-09-28T09:15:00Z",
    user_id: "00000000-0000-0000-0000-000000000001",
  },
  {
    id: "33333333-3333-3333-3333-333333333333",
    created_at: "2026-09-20T14:45:00Z",
    deviation_count: null,
    original_filename: "raport_lipiec.csv",
    row_count: null,
    uploaded_at: "2026-09-20T14:45:00Z",
    user_id: "00000000-0000-0000-0000-000000000001",
  },
];
---

<Layout title="Kitchen sink – Lista raportów">
  <div class="min-h-screen p-4">
    <div class="mx-auto max-w-3xl py-8">
      <h1 class="mb-2 text-center text-2xl font-bold">Kitchen sink: karta wgrywania i lista raportów</h1>
      <p class="text-muted-foreground mb-8 text-center text-sm">
        Strona deweloperska — prezentuje wszystkie 7 stanów komponentów bez potrzeby realnych danych z Supabase.
      </p>

      <div class="flex flex-col gap-8">
        <!-- 1. Default -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">1. Domyślny (default)</h2>
          <ReportsList reports={sampleReports} page={1} client:load />
        </section>

        <!-- 2. Hover -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">2. Najechanie (hover)</h2>
          <p class="text-muted-foreground mb-4 text-sm">
            Statyczny zrzut ekranu nie utrwali stanu <code>:hover</code>. Wiersze tabeli przechodzą w
            <code>hover:bg-muted/50</code>, link „Zobacz raport” w{" "}
            <code>hover:bg-accent hover:text-accent-foreground</code>, a przycisk „Usuń raport” w{" "}
            <code>hover:bg-destructive/90</code> — najedź kursorem ręcznie, aby zweryfikować.
          </p>
          <ReportsList reports={sampleReports} page={1} client:load />
        </section>

        <!-- 3. Focus-visible -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">3. Widoczny fokus (focus-visible)</h2>
          <p class="text-muted-foreground mb-4 text-sm">
            Statyczny zrzut ekranu nie utrwali stanu <code>:focus-visible</code>. Przejdź klawiszem Tab do linku „Zobacz
            raport” poniżej — pokaże domyślny fokus przeglądarki, pokolorowany tokenem <code>--ring</code>
            przez globalną regułę <code>outline-ring/50</code> (src/styles/global.css), tak jak każdy inny element w
            apce. Przycisk „Usuń raport” (prawdziwy <code>&lt;Button&gt;</code>) dodatkowo ma własny
            <code>focus-visible:ring-ring/50</code>.
          </p>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Nazwa pliku</TableHead>
                <TableHead>Data wgrania</TableHead>
                <TableHead>Liczba wierszy</TableHead>
                <TableHead>Akcje</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              <TableRow>
                <TableCell>{sampleReports[0].original_filename}</TableCell>
                <TableCell>2026-10-01 10:00</TableCell>
                <TableCell>{sampleReports[0].row_count}</TableCell>
                <TableCell>
                  <div class="flex items-center gap-2">
                    <a
                      href={`/reports/${sampleReports[0].id}`}
                      class="text-primary hover:bg-accent hover:text-accent-foreground inline-flex size-8 cursor-pointer items-center justify-center rounded-md transition-colors"
                      title="Zobacz raport"
                      aria-label="Zobacz raport"
                    >
                      <Search className="size-4" />
                    </a>
                    <Button
                      type="button"
                      variant="destructive"
                      size="icon"
                      className="size-8 cursor-pointer"
                      title="Usuń raport"
                      aria-label="Usuń raport"
                    >
                      <Trash2 className="size-4" />
                    </Button>
                  </div>
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </section>

        <!-- 4. Upload card -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">4. Karta wgrywania</h2>
          <p class="text-muted-foreground mb-4 text-sm">
            Stany przeciągania i wgrywania (pasek postępu, Anuluj) pojawiają się dopiero po wybraniu pliku.
          </p>
          <ReportUpload client:load />
        </section>

        <!-- 5. Error -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">5. Błąd (error)</h2>
          <p class="text-muted-foreground mb-4 text-sm">
            Karty błędów wgrywania wykrywanych w przeglądarce (za duży plik, zły format, brak wymaganych kolumn), a pod
            nimi baner dla błędów zwracanych przez serwer (<code>?error=</code>).
          </p>
          <div class="space-y-4">
            <ReportUpload
              initialError={{ kind: "too_large", fileName: "trasowki-q3-2026.xlsx", size: 8178892 }}
              client:load
            />
            <ReportUpload initialError={{ kind: "bad_format", fileName: "trasowki-wrzesien-2026.pdf" }} client:load />
            <ReportUpload
              initialError={{
                kind: "missing_columns",
                fileName: "trasowki-wrzesien-2026.xlsx",
                columns: checkRequiredColumns(["przedstawiciel", "Klient", "Data wizyty", "gps_wlaczony"]),
              }}
              client:load
            />
            <Banner variant="error">Wiersz 12: nierozpoznana wartość gps_wlaczony (oczekiwano TAK/NIE).</Banner>
          </div>
        </section>

        <!-- 6. Empty -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">6. Pusty (empty)</h2>
          <ReportsList reports={[]} page={1} client:load />
        </section>

        <!-- 7. Loading -->
        <section class="w-full rounded-2xl border border-border bg-card p-8 shadow-sm">
          <h2 class="mb-4 text-xl font-bold">7. Ładowanie (loading)</h2>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Nazwa pliku</TableHead>
                <TableHead>Data wgrania</TableHead>
                <TableHead>Liczba wierszy</TableHead>
                <TableHead>Akcje</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {[0, 1, 2].map((i) => (
                <TableRow key={i}>
                  <TableCell>
                    <div class="bg-muted h-4 w-32 animate-pulse rounded" />
                  </TableCell>
                  <TableCell>
                    <div class="bg-muted h-4 w-28 animate-pulse rounded" />
                  </TableCell>
                  <TableCell>
                    <div class="bg-muted h-4 w-10 animate-pulse rounded" />
                  </TableCell>
                  <TableCell>
                    <div class="flex items-center gap-2">
                      <div class="bg-muted size-8 animate-pulse rounded-md" />
                      <div class="bg-muted size-8 animate-pulse rounded-md" />
                    </div>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </section>
      </div>
    </div>
  </div>
</Layout>
