---
import { authErrorMessage } from "@/lib/auth-errors";
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<AuthLayout title="Załóż konto">
  <div class="w-full max-w-[340px] space-y-6">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Załóż konto</h1>
      <p class="text-sm text-muted-foreground">
        Konto dla kierownika regionu. Na podany email wyślemy link aktywacyjny.
      </p>
    </div>
    <SignUpForm serverError={error} client:load />
    <p class="text-center text-sm text-muted-foreground">
      Masz już konto?{" "}
      <a href="/auth/signin" class="text-primary hover:underline">
        Zaloguj się
      </a>
    </p>
  </div>
</AuthLayout>
