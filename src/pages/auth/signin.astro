---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zaloguj się">
  <div class="flex min-h-screen items-center justify-center bg-slate-50 p-4">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="mb-6 text-center text-2xl font-bold text-slate-900">Zaloguj się</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-slate-500">
        Nie masz jeszcze konta?{" "}
        <a href="/auth/signup" class="text-indigo-600 hover:underline">
          Zarejestruj się
        </a>
      </p>
    </div>
  </div>
</Layout>
