---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Zaloguj się">
  <div class="w-full max-w-[340px] space-y-6">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Zaloguj się</h1>
      <p class="text-sm text-muted-foreground">Wpisz email i hasło, aby przejść do raportów.</p>
    </div>
    <SignInForm serverError={error} client:load />
    <p class="text-center text-sm text-muted-foreground">
      Nie masz konta?{" "}
      <a href="/auth/signup" class="text-primary hover:underline">
        Zarejestruj się
      </a>
    </p>
  </div>
</AuthLayout>
