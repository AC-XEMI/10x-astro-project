---
import { CircleCheck, Mail } from "lucide-react";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { getPendingSignupEmail } from "@/lib/pending-signup";
import { authErrorMessage } from "@/lib/auth-errors";

// With email confirmations disabled (local Supabase, see supabase/config.toml) signUp() already
// returns a session, so the user arrives here signed in and confirmed - nothing to wait for.
const user = Astro.locals.user;
const isConfirmed = Boolean(user?.email_confirmed_at);
const email = getPendingSignupEmail(Astro.cookies);
const error = authErrorMessage(Astro.url.searchParams.get("error"));
const resent = Astro.url.searchParams.has("resent");
---

<AuthLayout title={isConfirmed ? "Konto założone" : "Sprawdź skrzynkę"}>
  <div class="w-full max-w-[360px] space-y-6 text-center">
    {isConfirmed ? (
      <>
        <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-success/10 text-success">
          <CircleCheck className="size-6" />
        </div>
        <div class="space-y-2">
          <h1 class="text-2xl font-semibold tracking-tight">Konto założone</h1>
          <p class="text-sm text-pretty text-muted-foreground">
            Twoje konto jest aktywne. Możesz od razu przejść do raportów.
          </p>
        </div>
        <a href="/reports" class:list={buttonVariants({ className: "w-full" })}>
          Przejdź do raportów
        </a>
      </>
    ) : (
      <>
        <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-primary/10 text-primary">
          <Mail className="size-6" />
        </div>
        <div class="space-y-2">
          <h1 class="text-2xl font-semibold tracking-tight">Sprawdź skrzynkę</h1>
          <p class="text-sm text-pretty text-muted-foreground">
            {email ? (
              <>
                Wysłaliśmy link aktywacyjny na adres <span class="font-medium text-foreground">{email}</span>.
              </>
            ) : (
              "Wysłaliśmy link aktywacyjny na podany adres email."
            )}{" "}
            Kliknij go, aby potwierdzić email i dokończyć zakładanie konta.
          </p>
        </div>
        {resent && (
          <Alert variant="success" role="status">
            <AlertDescription className="text-current">Wysłaliśmy link ponownie.</AlertDescription>
          </Alert>
        )}
        {error && (
          <Alert variant="destructive">
            <AlertDescription className="text-current">{error}</AlertDescription>
          </Alert>
        )}
        <div class="rounded-md bg-muted p-3 text-left text-sm text-pretty text-muted-foreground">
          Link jest ważny przez ograniczony czas. Nie widzisz wiadomości? Sprawdź folder Spam lub Oferty.
        </div>
        <div class="grid gap-2">
          {email && (
            <form method="POST" action="/api/auth/resend-confirmation" class="grid">
              <button type="submit" class:list={buttonVariants({ variant: "outline", className: "cursor-pointer" })}>
                <Mail />
                Wyślij link ponownie
              </button>
            </form>
          )}
          <a href="/auth/signin" class:list={buttonVariants({ variant: "link" })}>
            Wróć do logowania
          </a>
        </div>
      </>
    )}
  </div>
</AuthLayout>
