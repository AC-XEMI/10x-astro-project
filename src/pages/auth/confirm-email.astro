---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Rejestracja zakończona",
      description: "Twoje konto zostało utworzone. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź swoją skrzynkę",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, żeby aktywować konto.",
      linkText: "Powrót do logowania",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center bg-slate-50 p-4">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 text-2xl font-bold text-slate-900">{content.heading}</h1>
      <p class="mb-6 text-slate-600">{content.description}</p>
      <a href="/auth/signin" class="text-sm text-indigo-600 hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
