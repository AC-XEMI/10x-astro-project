---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div
  class:list={[
    "banner",
    variant === "error" && "border-destructive bg-destructive/10 text-destructive",
    variant === "info" && "border-border bg-accent text-accent-foreground",
    variant === "warning" && "banner--warning",
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  /* No `warning` token exists yet — kept as a scoped literal until one is added. */
  .banner--warning {
    background: #fef3c7;
    color: #78350f;
    border-color: #f59e0b;
  }
</style>
