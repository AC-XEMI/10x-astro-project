---
const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm shadow-sm">
  {user ? (
    <>
      <span class="text-slate-500">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/" class="text-indigo-600 transition-colors hover:text-indigo-700 hover:underline">
          Strona główna
        </a>
        <a href="/reports" class="text-indigo-600 transition-colors hover:text-indigo-700 hover:underline">
          Raporty
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-indigo-600 transition-colors hover:text-indigo-700 hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-slate-500">Niezalogowany</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-indigo-600 transition-colors hover:text-indigo-700 hover:underline">
          Zaloguj się
        </a>
        <a href="/auth/signup" class="text-indigo-600 transition-colors hover:text-indigo-700 hover:underline">
          Zarejestruj się
        </a>
      </div>
    </>
  )}
</div>
