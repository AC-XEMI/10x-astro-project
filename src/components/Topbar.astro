---
const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm shadow-sm">
  {user ? (
    <>
      <span class="text-slate-500">{user.email}</span>
      <div class="flex items-center gap-1">
        <a
          href="/"
          class="rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          Strona główna
        </a>
        <a
          href="/reports"
          class="rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          Raporty
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="cursor-pointer rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
          >
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-slate-500">Niezalogowany</span>
      <div class="flex gap-1">
        <a
          href="/auth/signin"
          class="rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          Zarejestruj się
        </a>
      </div>
    </>
  )}
</div>
