---
import { Home, FileText, LogOut } from "lucide-react";

const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm shadow-sm">
  {user ? (
    <>
      <span class="text-slate-500">{user.email}</span>
      <div class="flex items-center gap-1">
        <a
          href="/"
          title="Strona główna"
          aria-label="Strona główna"
          class="rounded-md p-2 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          <Home className="size-4" />
        </a>
        <a
          href="/reports"
          title="Raporty"
          aria-label="Raporty"
          class="rounded-md p-2 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          <FileText className="size-4" />
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            title="Wyloguj"
            aria-label="Wyloguj"
            class="cursor-pointer rounded-md p-2 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
          >
            <LogOut className="size-4" />
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-slate-500">Niezalogowany</span>
      <div class="flex gap-1">
        <a
          href="/auth/signin"
          class="rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="rounded-md px-2 py-1 text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-700"
        >
          Zarejestruj się
        </a>
      </div>
    </>
  )}
</div>
