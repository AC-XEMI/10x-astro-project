---
import { LogOut, MapPin } from "lucide-react";

const { user } = Astro.locals;
// Signup collects only email + password, so a display name exists only if one was set in
// Supabase user_metadata (e.g. via the dashboard); otherwise fall back to the email.
const metadataName: unknown = user?.user_metadata.full_name ?? user?.user_metadata.name;
const displayName = typeof metadataName === "string" && metadataName.trim() ? metadataName.trim() : user?.email;
const navLink =
  "text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex size-8 cursor-pointer items-center justify-center rounded-md transition-colors";
---

<header class="border-b border-border bg-card">
  <div class="mx-auto flex max-w-[1100px] items-center justify-between gap-4 px-6 py-3">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-foreground">
      <MapPin className="size-4 text-primary" />
      <span>Kontrola Trasówek</span>
    </a>
    {user ? (
      <div class="flex min-w-0 items-center gap-2 text-sm">
        <span class="truncate text-muted-foreground">{displayName}</span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" title="Wyloguj" aria-label="Wyloguj" class:list={navLink}>
            <LogOut className="size-4" />
          </button>
        </form>
      </div>
    ) : (
      <div class="flex items-center gap-1 text-sm">
        <a
          href="/auth/signin"
          class="rounded-md px-2 py-1 text-primary transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="rounded-md px-2 py-1 text-primary transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          Zarejestruj się
        </a>
      </div>
    )}
  </div>
</header>
